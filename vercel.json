{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/mp-webhook", "dest": "/api/mp-webhook.js" },
    { "src": "/api/create-payment", "dest": "/api/create-payment.js" },
    { "src": "/api/create-cart-payment", "dest": "/api/create-cart-payment.js" },
    { "src": "/api/create-subscription", "dest": "/api/create-subscription.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
